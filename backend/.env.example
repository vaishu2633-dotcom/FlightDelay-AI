# ==============================================================================
# FlightDelay AI: Backend Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# NEVER commit the actual .env file or production secret keys to version control.
# ==============================================================================

# Application Configuration
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Supabase PostgreSQL Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Machine Learning Storage
MODEL_REGISTRY_PATH=../ml/models
